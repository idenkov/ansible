# Managed by Ansible - roles/server/files/nginx_mailcow.j2. Do not edit in place.
#
# Terminates TLS for the mailcow web UI and keeps the ACME webroot reachable.
# mailcow itself stays on SKIP_LETS_ENCRYPT=y: certbot owns the certificate and
# {{ mailcow_cert_hook }} copies it into postfix/dovecot. Running mailcow's own
# ACME client as well would mean two clients competing for the same names.

server {
    listen 80;
    listen [::]:80;
    server_name {{ mailcow_cert_names | join(' ') }};

    # Must stay on plain HTTP and must not be redirected, or renewal fails.
    location /.well-known/acme-challenge/ {
        root {{ mailcow_webroot }};
    }

    location / {
        return 301 https://{{ mailcow_hostname }}$request_uri;
    }
}
{% if mailcow_cert_ready %}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name {{ mailcow_cert_names | join(' ') }};

    error_log /var/log/nginx/{{ mailcow_hostname }}_error.log warn;
    access_log /var/log/nginx/{{ mailcow_hostname }}_access.log;

    ssl_certificate {{ mailcow_cert_live }}/fullchain.pem;
    ssl_certificate_key {{ mailcow_cert_live }}/privkey.pem;

    # Mailbox imports and attachments go through here; the 1m default truncates
    # them with a 413.
    client_max_body_size 0;

    location / {
        proxy_pass http://{{ mailcow_upstream }};
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # SOGo's ActiveSync holds connections open far past the 60s default.
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_read_timeout 3600;
        proxy_send_timeout 3600;
    }
}
{% endif %}
