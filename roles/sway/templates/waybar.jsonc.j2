// waybar config, mirrors the i3blocks bar from roles/i3/files/i3blocks.conf
{
    "position": "bottom",
    "height": 40,
    "modules-left": ["sway/workspaces", "sway/mode"],
    "modules-right": [
        "pulseaudio", "memory", "disk", "network",
        "temperature", "load", {% if is_laptop %}"power-profiles-daemon", {% endif %}"battery", "sway/language", "tray", "clock"
    ],

    "pulseaudio": {
        "format": "VOL {volume}%",
        "format-muted": "VOL muted",
        "on-click": "pactl set-sink-mute @DEFAULT_SINK@ toggle",
        "scroll-step": 5
    },
    "memory": {
        "interval": 30,
        "format": "MEM {used:0.1f}G"
    },
    "disk": {
        "interval": 60,
        "path": "/",
        "format": "{free}"
    },
    "network": {
        "interval": 10,
        "format-wifi": "{essid} ({signalStrength}%) {ipaddr}",
        "format-ethernet": "{ifname} {ipaddr}",
        "format-disconnected": "offline"
    },
    "temperature": {
        "interval": 10,
        "critical-threshold": 85,
        "format": "{temperatureC}°C"
    },
    "load": {
        "interval": 10,
        "format": "{load1} {load5} {load15}"
    },
    "power-profiles-daemon": {
        "format": "{icon}",
        "format-icons": {
            "performance": "PERF",
            "balanced": "BAL",
            "power-saver": "SAVE"
        },
        "tooltip-format": "Power profile: {profile} (click to change)"
    },
    "battery": {
        "interval": 30,
        "states": { "warning": 20, "critical": 10 },
        "format": "BAT {capacity}%",
        "format-charging": "BAT {capacity}% +",
        "format-full": "BAT full"
    },
    "sway/language": {
        "format": "{short}"
    },
    "tray": {
        "spacing": 10,
        "icon-size": 20
    },
    "clock": {
        "interval": 5,
        "format": "{:%Y-%m-%d %H:%M:%S}",
        "tooltip-format": "<tt>{calendar}</tt>",
        "calendar": {
            "mode": "month",
            "weeks-pos": "left",
            "on-scroll": 1,
            "format": {
                "months": "<span color='#e2e4e6'><b>{}</b></span>",
                "weeks": "<span color='#a3a7ad'>{}</span>",
                "weekdays": "<span color='#a3a7ad'>{}</span>",
                "today": "<span color='#8fa8c8'><b><u>{}</u></b></span>"
            }
        },
        "actions": {
            "on-scroll-up": "shift_up",
            "on-scroll-down": "shift_down"
        },
        "on-click": "~/.config/waybar/calendar-toggle.sh"
    }
}
